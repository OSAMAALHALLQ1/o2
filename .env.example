# ==========================================
# O2 UNIVERSE MONOREPO ENVIRONMENT TEMPLATE
# ==========================================

# NODE RUNTIME
NODE_ENV=development
PORT=4000

# POSTGRESQL DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/o2_db?schema=public"

# REDIS CACHE & REALTIME
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT SECRETS
JWT_ACCESS_SECRET="dev-jwt-access-secret-change-in-prod-min-32-chars-length"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-in-prod-min-32-chars-length"

# LIVEKIT VOICE ADAPTER (OPTIONAL / MOCK IN DEV)
LIVEKIT_API_KEY="dev-key"
LIVEKIT_API_SECRET="dev-secret"
LIVEKIT_WS_URL="wss://livekit.local"

# RESTAURANT INTEGRATION WEBHOOK SECRET
O2_RESTAURANT_WEBHOOK_SECRET="dev-o2-webhook-secret-min-32-chars"
O2_QR_SIGNING_SECRET="dev-o2-qr-secret-min-32-chars"

# MOBILE APP CONFIG
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_WS_URL="ws://localhost:4000"
EXPO_PUBLIC_APP_ENV="development"

# ADMIN DASHBOARD CONFIG
NEXT_PUBLIC_API_URL="http://localhost:4000"
