{
  "name": "@o2/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --max-warnings 10"
  },
  "dependencies": {
    "@o2/types": "workspace:*",
    "@o2/ui": "workspace:*",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.15",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@o2/config": "workspace:*",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.2"
  }
}
