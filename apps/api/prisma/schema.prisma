// O2 Universe — Prisma Schema (Phase 2, Phase 3 & Phase 4 Economy, Inventory, Shop & Cosmetics)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum ModerationStatus {
  ACTIVE
  MUTED
  SUSPENDED
  BANNED
}

enum UserRole {
  PLAYER
  MODERATOR
  RESTAURANT_ADMIN
  SUPER_ADMIN
}

// Phase 4 Enums
enum CurrencyKind {
  COIN
  GEM
  EVENT_TOKEN
}

enum CurrencyScopeType {
  EVENT
  SEASON
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum CurrencyLedgerSource {
  WELCOME_BONUS
  SHOP_PURCHASE
  MATCH_REWARD
  DAILY_MISSION
  ACHIEVEMENT
  COMPANION_FEED
  REAL_ORDER_VERIFIED
  QR_RECEIPT_REDEMPTION
  ADMIN_ADJUSTMENT
  EVENT_REWARD
}

enum ItemType {
  CONSUMABLE
  COSMETIC
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum CosmeticSlot {
  HEAD
  FACE
  BODY
  BACK
  AURA
  NAME_FRAME
}

enum InventoryLedgerDirection {
  GRANT
  CONSUME
  REVOKE
}

enum FriendRequestPolicy {
  EVERYONE
  NOBODY
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PartyStatus {
  ACTIVE
  CLOSED
}

enum PartyReadyState {
  READY
  NOT_READY
}

enum PartyGameMode {
  ATRASH
  MAFIA_CLASSIC
  TARNEEB
  HIDE_AND_SEEK
  O2_IMPOSTER
}

enum PartyInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model User {
  id               String           @id @default(uuid())
  role             UserRole         @default(PLAYER)
  moderationStatus ModerationStatus @default(ACTIVE)
  lastActiveAt     DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  identities     AuthIdentity[]
  sessions       UserSession[]
  profile        PlayerProfile?
  careState      CompanionCareState?
  careActionLogs CompanionActionLog[]

  // Phase 4 relations
  currencyAccounts  CurrencyAccount[]
  currencyLedger    CurrencyLedgerEntry[]
  inventory         UserInventory[]
  inventoryLedger   InventoryLedgerEntry[]
  shopPurchases     ShopPurchase[]
  equippedCosmetics EquippedCosmetic[]
  cosmeticActions   CosmeticActionRecord[]

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendshipsLow         Friendship[]    @relation("FriendshipLow")
  friendshipsHigh        Friendship[]    @relation("FriendshipHigh")
  blocksCreated          UserBlock[]     @relation("Blocker")
  blocksReceived         UserBlock[]     @relation("Blocked")
  socialPrivacy          SocialPrivacy?
  ledParties             Party[]         @relation("PartyLeader")
  partyMembership        PartyMember?
  sentPartyInvites       PartyInvite[]   @relation("PartyInviter")
  receivedPartyInvites   PartyInvite[]   @relation("PartyInvitee")

  @@map("users")
}

model AuthIdentity {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String // Normalized email or OAuth subject ID
  passwordHash String? // Argon2id hash (EMAIL provider only)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  familyId   String // Refresh token family UUID for rotation and replay revocation
  deviceInfo String? // OS, Client Model, App Version
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshTokenRecord[]

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

model RefreshTokenRecord {
  id                String    @id @default(uuid())
  sessionId         String
  tokenHash         String    @unique // Deterministic SHA-256 hash of rotating refresh token
  familyId          String // Denormalized familyId for immediate family-wide revocation
  consumedAt        DateTime? // Non-null once used in rotation
  revokedAt         DateTime? // Set if session/family is invalidated
  replacedByTokenId String? // Pointer to newly issued child token
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@map("refresh_token_records")
}

model PlayerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  username            String?
  normalizedUsername  String?  @unique // Lowercase trimmed handle for strict case-insensitive uniqueness
  displayName         String?
  language            String   @default("ar")
  selectedCharacterId String?
  isOnboarded         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedCharacter Character? @relation(fields: [selectedCharacterId], references: [id])

  @@index([selectedCharacterId])
  @@map("player_profiles")
}

model Character {
  id               String   @id @default(uuid())
  slug             String   @unique
  nameAr           String
  nameEn           String
  descriptionAr    String
  archetype        String
  placeholderAsset String
  isStarter        Boolean  @default(true)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profiles         PlayerProfile[]
  cosmeticVariants CosmeticVariant[]

  @@map("characters")
}

// Phase 3: Living Companion Care & Idempotency Models
model CompanionCareState {
  id                String    @id @default(uuid())
  userId            String    @unique
  hunger            Float     @default(80.0)
  cleanliness       Float     @default(80.0)
  energy            Float     @default(80.0)
  mood              Float     @default(80.0)
  isSleeping        Boolean   @default(false)
  sleepStartedAt    DateTime?
  lastSimulatedAt   DateTime  @default(now())
  lastInteractionAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companion_care_states")
}

model CompanionActionLog {
  id              String   @id @default(uuid())
  userId          String
  clientActionId  String
  actionType      String
  appliedAt       DateTime @default(now())
  responsePayload Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientActionId])
  @@index([userId])
  @@map("companion_action_logs")
}

// Phase 4: Server-Authoritative Economy, Inventory, Shop & Cosmetics

model CurrencyAccount {
  id           String             @id @default(uuid())
  userId       String
  currencyKind CurrencyKind
  scopeType    CurrencyScopeType?
  scopeId      String?
  balance      BigInt             @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currencyKind, scopeType, scopeId])
  @@index([userId])
  @@map("currency_accounts")
}

model CurrencyLedgerEntry {
  id                 String               @id @default(uuid())
  userId             String
  currencyKind       CurrencyKind
  scopeType          CurrencyScopeType?
  scopeId            String?
  direction          LedgerDirection
  amount             BigInt
  balanceAfter       BigInt
  sourceType         CurrencyLedgerSource
  sourceId           String?
  idempotencyKey     String
  requestFingerprint String?
  metadata           Json?
  createdAt          DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([currencyKind, scopeType, scopeId])
  @@map("currency_ledger_entries")
}

model ItemDefinition {
  id               String        @id @default(uuid())
  slug             String        @unique
  type             ItemType
  rarity           ItemRarity
  nameAr           String
  nameEn           String
  descriptionAr    String
  descriptionEn    String
  assetKey         String
  cosmeticSlot     CosmeticSlot?
  hungerDelta      Float?
  cleanlinessDelta Float?
  energyDelta      Float?
  moodDelta        Float?
  reactionKey      String?
  isActive         Boolean       @default(true)
  isStackable      Boolean       @default(false)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  inventories      UserInventory[]
  shopOffers       ShopOffer[]
  equippedBy       EquippedCosmetic[]
  purchases        ShopPurchase[]
  inventoryLedger  InventoryLedgerEntry[]
  cosmeticActions  CosmeticActionRecord[]
  cosmeticVariants CosmeticVariant[]

  @@map("item_definitions")
}

model CosmeticVariant {
  id          String   @id @default(uuid())
  itemId      String
  characterId String
  assetKey    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item      ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)
  character Character      @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([itemId, characterId])
  @@index([characterId])
  @@map("cosmetic_variants")
}

model UserInventory {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ItemDefinition @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_inventories")
}

model InventoryLedgerEntry {
  id                 String                   @id @default(uuid())
  userId             String
  itemId             String
  direction          InventoryLedgerDirection
  quantity           Int
  quantityAfter      Int
  sourceType         String
  sourceId           String?
  idempotencyKey     String
  requestFingerprint String
  metadata           Json?
  createdAt          DateTime                 @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  item ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("inventory_ledger_entries")
}

model ShopOffer {
  id                String             @id @default(uuid())
  slug              String             @unique
  itemId            String
  itemQuantity      Int                @default(1)
  currencyKind      CurrencyKind
  currencyScopeType CurrencyScopeType?
  currencyScopeId   String?
  priceAmount       BigInt
  isActive          Boolean            @default(true)
  sortOrder         Int                @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  item      ItemDefinition @relation(fields: [itemId], references: [id])
  purchases ShopPurchase[]

  @@map("shop_offers")
}

model ShopPurchase {
  id                  String             @id @default(uuid())
  userId              String
  offerId             String
  itemId              String
  itemQuantity        Int
  currencyKind        CurrencyKind
  currencyScopeType   CurrencyScopeType?
  currencyScopeId     String?
  priceAmount         BigInt
  clientTransactionId String
  requestFingerprint  String
  balanceAfter        BigInt
  quantityAfter       Int
  createdAt           DateTime           @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  offer ShopOffer      @relation(fields: [offerId], references: [id])
  item  ItemDefinition @relation(fields: [itemId], references: [id])

  @@unique([userId, clientTransactionId])
  @@index([userId])
  @@map("shop_purchases")
}

model EquippedCosmetic {
  id         String       @id @default(uuid())
  userId     String
  slot       CosmeticSlot
  itemId     String
  equippedAt DateTime     @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ItemDefinition @relation(fields: [itemId], references: [id])

  @@unique([userId, slot])
  @@index([userId])
  @@map("equipped_cosmetics")
}

model CosmeticActionRecord {
  id                  String       @id @default(uuid())
  userId              String
  clientTransactionId String
  requestFingerprint  String
  operation           String
  itemId              String?
  slot                CosmeticSlot
  responsePayload     Json
  createdAt           DateTime     @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  item ItemDefinition? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, clientTransactionId])
  @@index([userId])
  @@map("cosmetic_action_records")
}

model Friendship {
  id         String   @id @default(uuid())
  userLowId  String
  userHighId String
  createdAt  DateTime @default(now())

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId, createdAt])
  @@index([userHighId, createdAt])
  @@map("friendships")
}

model FriendRequest {
  id          String              @id @default(uuid())
  userLowId   String
  userHighId  String
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@index([userLowId, userHighId, status])
  @@map("friend_requests")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model SocialPrivacy {
  userId              String              @id
  friendRequestPolicy FriendRequestPolicy @default(EVERYONE)
  allowPartyInvites   Boolean             @default(true)
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_privacy")
}

model Party {
  id              String         @id @default(uuid())
  code            String         @unique
  leaderUserId    String
  status          PartyStatus    @default(ACTIVE)
  desiredGameMode PartyGameMode?
  allowJoinByCode Boolean        @default(false)
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  leader  User          @relation("PartyLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  members PartyMember[]
  invites PartyInvite[]

  @@index([leaderUserId])
  @@index([status, updatedAt])
  @@map("parties")
}

model PartyMember {
  id         String          @id @default(uuid())
  partyId    String
  userId     String          @unique
  readyState PartyReadyState @default(NOT_READY)
  joinedAt   DateTime        @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([partyId, joinedAt])
  @@map("party_members")
}

model PartyInvite {
  id          String            @id @default(uuid())
  partyId     String
  inviterId   String
  inviteeId   String
  status      PartyInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  party   Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  inviter User  @relation("PartyInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User  @relation("PartyInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status, createdAt])
  @@index([partyId, status])
  @@map("party_invites")
}
